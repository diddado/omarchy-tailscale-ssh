#!/bin/bash

# omarchy:summary=Generate Tailscale SSH rules from the machines on your tailnet
# omarchy:args=[--print] [--yes] [--status-file <file>] [--output <file>]

# Builds a starter rules file by looking at what is actually on your tailnet:
# clusters machine names into prefixes, spots the ones whose names are generated
# (and so must be matched by prefix, never by hostname), and picks up ACL tags.
#
# It never guesses a username. Every rule is written with the user left unset so
# it inherits defaultUser, and the interactive wizard asks you per group. A
# guessed "ubuntu" that happens to be wrong is worse than a blank you were asked
# to fill in.

set -euo pipefail

# Anything this script creates is private by default. Set before the first file
# is touched, because a chmod afterwards is a window, and it follows a symlink
# that may have replaced the name in the meantime.
umask 077

# Absolute paths, never a bare name: PATH is inherited and any other process
# running as this user can prepend to it.
JQ=/usr/bin/jq
DD=/usr/bin/dd
PYTHON=/usr/bin/python3
HEAD=/usr/bin/head
SORT=/usr/bin/sort
GREP=/usr/bin/grep
TR=/usr/bin/tr
SED=/usr/bin/sed
DATE=/usr/bin/date
ID=/usr/bin/id

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# The one implementation of hardened config I/O, shared with Service.qml: opens
# once with O_NOFOLLOW|O_NONBLOCK, validates the descriptor it holds, reads a
# bounded number of bytes from that same descriptor, and publishes a write by
# renaming a fresh 0600 temporary over the destination.
STATEFILE="$HERE/statefile"

# Ceilings. `tailscale status --json` describes machines named by whoever owns
# them, so its size is not this script's to assume.
MAX_STATUS_BYTES=$((1024 * 1024))
MAX_PEERS=2000
MAX_NAME=253

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/settings"
OUTPUT="$STATE_DIR/io.github.diddado.tailscale-ssh.json"
STATUS_FILE=""
PRINT_ONLY=false
ASSUME_YES=false

while [[ $# -gt 0 ]]; do
  case "$1" in
  --print) PRINT_ONLY=true; shift ;;
  --yes | -y) ASSUME_YES=true; shift ;;
  --status-file) STATUS_FILE="${2-}"; shift 2 ;;
  --status-file=*) STATUS_FILE="${1#*=}"; shift ;;
  --output) OUTPUT="${2-}"; shift 2 ;;
  --output=*) OUTPUT="${1#*=}"; shift ;;
  -h | --help)
    cat <<'USAGE'
Usage: setup [--print] [--yes] [--status-file <file>] [--output <file>]

  --print              Write the suggested config to stdout and exit.
  --yes                Accept every suggestion; do not prompt.
  --status-file FILE   Read `tailscale status --json` output from FILE.
  --output FILE        Write somewhere other than the default config path.

With no flags it runs an interactive wizard and writes the config file.
USAGE
    exit 0
    ;;
  *)
    echo "setup: unknown option '$1'. Try --help." >&2
    exit 2
    ;;
  esac
done

[[ -x $JQ ]] || { echo "setup: $JQ is required" >&2; exit 1; }
[[ -x $STATEFILE ]] || { echo "setup: $STATEFILE is missing" >&2; exit 1; }

# One open with O_NOFOLLOW, capped at MAX_STATUS_BYTES + 1 so an overflow is
# detected rather than silently truncated. A bare `<` redirect does not pass
# O_NOFOLLOW and `[[ -f ]]` followed by `cat` is two resolutions of one name.
read_file_bounded() {
  "$DD" if="$1" iflag=nofollow,nonblock,count_bytes,fullblock \
    bs=65536 count=$((MAX_STATUS_BYTES + 1)) status=none 2>/dev/null
}

read_status() {
  local raw
  if [[ -n $STATUS_FILE ]]; then
    raw="$(read_file_bounded "$STATUS_FILE")" \
      || { echo "setup: cannot read $STATUS_FILE" >&2; exit 1; }
    [[ -n $raw ]] || { echo "setup: $STATUS_FILE is empty or not a regular file" >&2; exit 1; }
  else
    # Own session, absolute deadline with KILL escalation, producer-side cap.
    raw="$("$HERE/tailscale-status")" || {
      local rc=$?
      if (( rc == 127 )); then
        echo "setup: the tailscale CLI was not found" >&2
      else
        echo "setup: tailscale status failed (exit $rc); is Tailscale connected?" >&2
      fi
      exit 1
    }
  fi
  if (( ${#raw} > MAX_STATUS_BYTES )); then
    echo "setup: status output exceeds ${MAX_STATUS_BYTES} bytes" >&2
    exit 1
  fi
  printf '%s' "$raw"
}

STATUS="$(read_status)"

# Identify the tailnet. Keyed on MagicDNSSuffix because it is unique, survives a
# rename, and is readable without root -- unlike `tailscale switch --list`,
# which needs an operator grant and is commonly denied.
# Both come off the network, so both are stripped of control characters and
# capped before they are printed or used as a JSON key.
clean() { printf '%s' "$1" | "$TR" -d '\000-\037\177' | "$HEAD" -c "$MAX_NAME"; }

TAILNET_KEY="$(clean "$("$JQ" -r '.MagicDNSSuffix // (.CurrentTailnet.MagicDNSSuffix // "") // ""' <<<"$STATUS")")"
TAILNET_NAME="$(clean "$("$JQ" -r '.CurrentTailnet.Name // ""' <<<"$STATUS")")"
[[ -z $TAILNET_KEY ]] && TAILNET_KEY="$TAILNET_NAME"
if [[ -z $TAILNET_KEY ]]; then
  echo "setup: could not determine which tailnet this is; is Tailscale connected?" >&2
  exit 1
fi

# hostname<TAB>tag,tag — Mullvad exit nodes are not machines you ssh into.
# Capped at MAX_PEERS rows and MAX_NAME characters per name: a tailnet is not
# obliged to be small, and a hostname is chosen by whoever owns the machine.
# Control characters are dropped here too -- a name reaches gum, a JSON key and
# a terminal from this one place.
PEERS="$("$JQ" -r --argjson max "$MAX_PEERS" --argjson len "$MAX_NAME" '
  [ (.Peer // {}) | to_entries[] | .value
    | select((.Tags // []) | index("tag:mullvad") | not)
    | select((.DNSName // "") | test("\\.mullvad\\.ts\\.net\\.?$") | not)
  ][:$max][]
  | ((.HostName // "") | tostring | .[:$len]) as $h
  | ([ (.Tags // [])[] | tostring | .[:$len] ] | .[:32] | join(",")) as $t
  | "\($h)\t\($t)"
' <<<"$STATUS" | "$TR" -d '\000-\010\013\014\016-\037\177')"

# ---------------------------------------------------------------- ephemeral

# Mirrors EPHEMERAL_TAIL in Model.js. A machine whose name ends in a generated
# id is replaced rather than restarted, so its hostname is worthless as a
# matcher — the stable prefix is the only durable handle.
stable_prefix() {
  local host="$1" IFS='-'
  read -r -a tokens <<<"$host"
  local i joined
  for ((i = 1; i < ${#tokens[@]}; i++)); do
    joined="$(IFS='-'; printf '%s' "${tokens[*]:i}")"
    if [[ $joined =~ ^(i-)?[0-9a-f]{8,}$ || $joined =~ ^[0-9a-z]{12,}$ ]]; then
      (IFS='-'; printf '%s' "${tokens[*]:0:i}-")
      return 0
    fi
  done
  printf ''
}

# ---------------------------------------------------------------- clustering

declare -A PREFIX_COUNT=() PREFIX_EPHEMERAL=() TAG_COUNT=()
HOSTS=()

while IFS=$'\t' read -r host tags; do
  [[ -n $host ]] || continue
  HOSTS+=("$host")

  eph="$(stable_prefix "$host")"
  if [[ -n $eph ]]; then
    # An ephemeral machine earns a prefix rule even when it is currently the
    # only one of its kind — tomorrow it will have a different name.
    PREFIX_COUNT["$eph"]=$(( ${PREFIX_COUNT["$eph"]:-0} + 1 ))
    PREFIX_EPHEMERAL["$eph"]=1
  else
    # Otherwise consider every token boundary as a candidate prefix; those
    # covering two or more machines are worth a rule.
    acc=""
    IFS='-' read -r -a toks <<<"$host"
    for ((i = 0; i < ${#toks[@]} - 1; i++)); do
      acc+="${toks[i]}-"
      PREFIX_COUNT["$acc"]=$(( ${PREFIX_COUNT["$acc"]:-0} + 1 ))
    done
  fi

  if [[ -n $tags ]]; then
    IFS=',' read -r -a taglist <<<"$tags"
    for t in "${taglist[@]}"; do
      [[ -n $t ]] && TAG_COUNT["$t"]=$(( ${TAG_COUNT["$t"]:-0} + 1 ))
    done
  fi
done <<<"$PEERS"

# Keep a prefix if it is ephemeral, or covers >=2 machines. Then drop any prefix
# that covers exactly the same machines as a longer one — the longer name is
# more descriptive and longest-prefix-wins makes the short one redundant.
KEPT=()
for p in "${!PREFIX_COUNT[@]}"; do
  [[ -n ${PREFIX_EPHEMERAL[$p]:-} || ${PREFIX_COUNT[$p]} -ge 2 ]] || continue
  redundant=false
  for q in "${!PREFIX_COUNT[@]}"; do
    [[ $q != "$p" && $q == "$p"* && ${PREFIX_COUNT[$q]} -eq ${PREFIX_COUNT[$p]} ]] && redundant=true && break
  done
  $redundant || KEPT+=("$p")
done
mapfile -t KEPT < <(printf '%s\n' "${KEPT[@]}" | "$GREP" -v '^$' | "$SORT")

# Machines not covered by any kept prefix get an exact-host stub.
STUBS=()
for h in "${HOSTS[@]}"; do
  covered=false
  for p in "${KEPT[@]}"; do [[ $h == "$p"* ]] && covered=true && break; done
  $covered || STUBS+=("$h")
done

# Tags on two or more machines are worth a rule of their own.
TAGS=()
for t in "${!TAG_COUNT[@]}"; do
  [[ ${TAG_COUNT[$t]} -ge 2 ]] && TAGS+=("$t")
done
mapfile -t TAGS < <(printf '%s\n' "${TAGS[@]}" | "$GREP" -v '^$' | "$SORT")

# ---------------------------------------------------------------- labels

title_case() {
  printf '%s' "$1" | "$TR" -- '-_' '  ' | "$SED" -E 's/^ +| +$//g; s/\b(.)/\u\1/g'
}

group_for_prefix() { title_case "${1%-}"; }
group_for_tag() { title_case "${1#tag:}"; }

# ---------------------------------------------------------------- assemble

# rule_user["<kind>\t<value>"] is filled in by the wizard; empty means inherit.
declare -A RULE_USER=()
declare -A PREFIX_LOOSE_KEYS=()
DEFAULT_USER="${USER:-$("$ID" -un)}"

# The reference written into the top of the config as "_readme", so anyone
# editing the JSON has the options in front of them. Kept identical to
# CONFIG_HELP in Model.js; test/setup.test.sh asserts the two match.
CONFIG_HELP_JSON=$(cat <<'HELPEOF'
[
  "Tailscale SSH rules. Edits apply immediately - no restart.",
  "Full docs: https://github.com/diddado/omarchy-tailscale-ssh",
  "",
  "Rules are kept per tailnet, under \"tailnets\", keyed by MagicDNS suffix.",
  "The machines change completely when you switch accounts, so rules written",
  "for one tailnet would be meaningless on another. Switching to a tailnet with",
  "no section here makes the panel offer to set it up; your other sections are",
  "never touched.",
  "",
  "\"defaultUser\" and \"sshArgs\" at the top level apply to every tailnet; a",
  "tailnet may override defaultUser and adds to sshArgs.",
  "",
  "Each rule needs exactly one matcher:",
  "  host    exact machine name, or its full MagicDNS name (case-insensitive)",
  "  tag     a Tailscale ACL tag; the 'tag:' prefix is optional",
  "  regex   JavaScript regex tested against the machine name",
  "  prefix  machine-name prefix; the LONGEST match wins",
  "",
  "Rules MERGE weakest-to-strongest, rather than first-match-wins:",
  "  defaults < prefix < regex < tag < host",
  "So a prefix rule can set the user for a whole fleet while an exact host rule",
  "overrides only that machine's port. Fields you do not mention are inherited.",
  "sshArgs accumulate across tiers instead of replacing.",
  "",
  "Optional on any rule:",
  "  user     SSH login user",
  "  port     passed as ssh -p",
  "  sshArgs  extra flags, e.g. [\"-i\", \"~/.ssh/id_ed25519\"]",
  "  command  run this instead of a login shell; ssh -t is added for you.",
  "           e.g. \"tmux new -A -s work\" attaches to the session named work,",
  "           creating it first if it does not exist yet.",
  "  label    friendlier display name in the panel",
  "  group    section heading to file the machine under",
  "  address  override what ssh actually connects to",
  "  hidden   true drops the machine from the list",
  "",
  "Top level: defaultUser, sshArgs, connectVia (dns|ip|hostname), rules.",
  "",
  "Re-run setup any time to regenerate groups from your tailnet:",
  "  ~/.config/omarchy/plugins/io.github.diddado.tailscale-ssh/bin/setup"
]
HELPEOF
)

emit_config() {
  local rules="[]" p t h group user args

  for p in "${KEPT[@]}"; do
    [[ -n $p ]] || continue
    group="$(group_for_prefix "$p")"
    user="${RULE_USER["prefix	$p"]:-}"
    args="[]"
    # A fleet with generated names re-uses addresses, so a pinned host key will
    # eventually mismatch and block the connection.
    [[ -n ${PREFIX_EPHEMERAL[$p]:-} && -n ${PREFIX_LOOSE_KEYS[$p]:-} ]] &&
      args='["-o","StrictHostKeyChecking=accept-new","-o","UserKnownHostsFile=/dev/null"]'
    rules="$("$JQ" -c --arg prefix "$p" --arg group "$group" --arg user "$user" --argjson args "$args" \
      '. + [ ({prefix: $prefix, group: $group}
             + (if $user == "" then {} else {user: $user} end)
             + (if ($args | length) == 0 then {} else {sshArgs: $args} end)) ]' <<<"$rules")"
  done

  for t in "${TAGS[@]}"; do
    [[ -n $t ]] || continue
    group="$(group_for_tag "$t")"
    user="${RULE_USER["tag	$t"]:-}"
    rules="$("$JQ" -c --arg tag "$t" --arg group "$group" --arg user "$user" \
      '. + [ ({tag: $tag, group: $group}
             + (if $user == "" then {} else {user: $user} end)) ]' <<<"$rules")"
  done

  for h in "${STUBS[@]}"; do
    [[ -n $h ]] || continue
    user="${RULE_USER["host	$h"]:-}"
    rules="$("$JQ" -c --arg host "$h" --arg user "$user" \
      '. + [ ({host: $host}
             + (if $user == "" then {} else {user: $user} end)) ]' <<<"$rules")"
  done

  # Merge into the existing document so other tailnets survive. A v1 file (flat
  # `rules`) is migrated by attributing its rules to the tailnet connected now,
  # which is the only tailnet they could have been written for.
  local existing='{}' current
  current="$(read_config)" || current=""
  if [[ -n $current ]] && "$JQ" -e 'type == "object"' >/dev/null 2>&1 <<<"$current"; then
    existing="$current"
  fi

  "$JQ" -n --arg defaultUser "$DEFAULT_USER" --argjson rules "$rules" \
    --argjson readme "$CONFIG_HELP_JSON" --argjson existing "$existing" \
    --arg key "$TAILNET_KEY" --arg name "$TAILNET_NAME" '
    ($existing | if (.tailnets | type) == "object" then .tailnets else {} end) as $known
    | ($existing
       | if (.tailnets | type) != "object" and (.rules | type) == "array"
         then { ($key): { name: $name, rules: .rules } }
         else {} end) as $migrated
    | {
        _readme: $readme,
        version: 2,
        defaultUser: ($existing.defaultUser // $defaultUser),
        sshArgs: ($existing.sshArgs // ["-o", "ServerAliveInterval=30"]),
        tailnets: ($known + { ($key): { name: $name, rules: $rules } })
      }
      + (if (($existing.tailnets | type) != "object") and (($existing.rules | type) == "array")
         then { rules: $existing.rules } else {} end)'
}

# Reads and writes go through bin/statefile so this script and the panel share
# one implementation: a single O_NOFOLLOW|O_NONBLOCK open validated on the
# descriptor it returns, and a publish that renames a fresh 0600 temporary over
# the destination rather than truncating a name a symlink may have claimed.
# Exit 3 from the helper means "not there yet", which is not an error here.
read_config() {
  local out rc
  out="$("$PYTHON" -I "$STATEFILE" read "$OUTPUT")" && { printf '%s' "$out"; return 0; }
  rc=$?
  (( rc == 3 )) && return 0
  return "$rc"
}

write_config() {
  "$PYTHON" -I "$STATEFILE" write "$OUTPUT"
}

if $PRINT_ONLY; then
  emit_config
  exit 0
fi

# ---------------------------------------------------------------- wizard

# gum only draws the wizard -- it never receives a secret and never decides
# anything -- but it is still resolved to an absolute path rather than through
# an inherited PATH.
GUM=/usr/bin/gum
have_gum() { [[ -x $GUM ]]; }

# `--` before every data argument: a group label derived from a hostname can
# begin with a dash, and gum would read that as an option.
say() { if have_gum; then "$GUM" style --foreground 212 -- "$1"; else printf '%s\n' "$1"; fi; }
note() { if have_gum; then "$GUM" style --foreground 244 -- "  $1"; else printf '  %s\n' "$1"; fi; }

ask_user() {
  local label="$1" placeholder="$2"
  if $ASSUME_YES || ! have_gum; then printf ''; return; fi
  # The answer is bounded here rather than trusted: it becomes an ssh login
  # user, and Model.js refuses one that does not validate.
  "$GUM" input --placeholder "$placeholder" --prompt "  SSH user for $label > " \
    | "$TR" -cd 'A-Za-z0-9._-' | "$HEAD" -c 32
}

ask_yes() {
  local prompt="$1"
  $ASSUME_YES && return 0
  have_gum || return 1
  "$GUM" confirm -- "$prompt"
}

total=$(( ${#KEPT[@]} + ${#TAGS[@]} + ${#STUBS[@]} ))
if [[ $total -eq 0 ]]; then
  echo "No machines found on the tailnet. Is Tailscale connected?" >&2
  exit 1
fi

say "Tailnet: ${TAILNET_NAME:-$TAILNET_KEY}"
say "Found $(printf '%s' "${#HOSTS[@]}") machines on it."
existing_now="$(read_config)" || existing_now=""
if [[ -n $existing_now ]] && "$JQ" -e --arg k "$TAILNET_KEY" '.tailnets[$k] // empty' >/dev/null 2>&1 <<<"$existing_now"; then
  note "This tailnet already has rules; they will be replaced."
  note "Rules for your other tailnets are not touched."
fi
echo
say "Groups detected"
for p in "${KEPT[@]}"; do
  [[ -n $p ]] || continue
  if [[ -n ${PREFIX_EPHEMERAL[$p]:-} ]]; then
    note "$p*  ${PREFIX_COUNT[$p]} machine(s), names are generated"
  else
    note "$p*  ${PREFIX_COUNT[$p]} machines"
  fi
done
for t in "${TAGS[@]}"; do [[ -n $t ]] && note "$t  ${TAG_COUNT[$t]} machines"; done
for h in "${STUBS[@]}"; do [[ -n $h ]] && note "$h"; done
echo
note "Leave a user blank to inherit the default ($DEFAULT_USER)."
echo

for p in "${KEPT[@]}"; do
  [[ -n $p ]] || continue
  RULE_USER["prefix	$p"]="$(ask_user "$p*" "e.g. ubuntu")"
  if [[ -n ${PREFIX_EPHEMERAL[$p]:-} ]]; then
    if ask_yes "  $p* names are generated. Skip host-key checking for them?"; then
      PREFIX_LOOSE_KEYS["$p"]=1
    fi
  fi
done
for t in "${TAGS[@]}"; do
  [[ -n $t ]] || continue
  RULE_USER["tag	$t"]="$(ask_user "$t" "blank to inherit")"
done
for h in "${STUBS[@]}"; do
  [[ -n $h ]] || continue
  RULE_USER["host	$h"]="$(ask_user "$h" "blank to inherit")"
done

# The backup is written the same way the config is -- through the helper, into
# a fresh 0600 file published by rename -- rather than with `cp`, which creates
# it under the ambient umask and follows a symlink planted on the name. The
# state directory is created by the helper, walking the chain with held
# descriptors, so there is no `mkdir -p` on a path this script then trusts.
existing_doc="$(read_config)" || existing_doc=""
if [[ -n $existing_doc ]]; then
  backup="$OUTPUT.bak.$("$DATE" -u +%Y%m%d%H%M%S)"
  if OUTPUT="$backup" write_config <<<"$existing_doc"; then
    note "Existing config backed up to $backup"
  else
    note "Could not write a backup; the existing config is left in place."
    exit 1
  fi
fi

emit_config | write_config

echo
say "Wrote $OUTPUT"
note "The panel picks this up immediately — no restart needed."
note "Edit it any time from the panel, or with: \$EDITOR $OUTPUT"
